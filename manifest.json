{
  "manifest_version": 3,
  "name": "Fullscreen Navigation",
  "short_name": "FullNav",
  "version": "0.1",
  "description": "Navigate your tabs, windows and bookmarks from the edge of the screen while your browser is in fullscreen.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "search",
    "bookmarks",
    "sessions",
    "favicon"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "fn-css.js",
        "fn-push.js",
        "fn-menu.js",
        "fn-bookmarks.js",
        "fn-drop.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "options.html",
        "options.css",
        "options.js",
        "defaults.js",
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "FullNav settings",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-pin": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Pin or hide the tab overlay"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fullnav@example.com",
      "strict_min_version": "121.0"
    }
  }
}
